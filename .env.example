# Docker Compose reads this file after it is copied to .env.
# Generate a token with: openssl rand -hex 32
MUSE_ACCESS_TOKEN=
# Host-side listening address; set a LAN address only when intended.
MUSE_HOST_BIND=127.0.0.1
MUSE_HOST_PORT=8787
# Browser-reachable host (no protocol or port); use the server LAN IP for LAN clients.
MUSE_PUBLIC_HOST=127.0.0.1
MUSE_UPSTREAM_ORIGIN=https://muse.ai
