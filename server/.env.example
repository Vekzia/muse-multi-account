NODE_ENV=development
MUSE_BIND=127.0.0.1
MUSE_PORT=8787
# Required when NODE_ENV=production. Keep this out of source control.
MUSE_ACCESS_TOKEN=
MUSE_UPSTREAM_ORIGIN=https://muse.ai
MUSE_DATA_DIR=./server-data
# Browser-reachable hostname/IP used for account origin URLs when exposed.
MUSE_PUBLIC_HOST=127.0.0.1
