{
  "name": "muse-multi-account-server",
  "version": "1.8.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run src/api src/server.test.ts src/server-integration.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "fastify": "5.12.8",
    "socks-proxy-agent": "8.0.5",
    "tough-cookie": "5.1.2",
    "undici": "6.29.1",
    "wreq-js": "3.2.0",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "20.19.43",
    "@types/ws": "8.18.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
