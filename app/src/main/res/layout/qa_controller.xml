<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="20dp">
    <ScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/qa_title" android:textColor="#E9EBEE" android:textSize="20sp" android:textStyle="bold" />
    <TextView android:id="@+id/qa_description" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="8dp" android:paddingBottom="12dp" android:text="@string/qa_description"
        android:textColor="#ADB4C0" android:textSize="14sp" />
    <Switch android:id="@+id/qa_notification" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="56dp" android:text="@string/qa_notification_toggle" android:textColor="#E9EBEE" android:textSize="16sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/qa_notification_description"
        android:textColor="#8A9099" android:textSize="12sp" />
    <Switch android:id="@+id/qa_overlay" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="56dp" android:text="@string/qa_overlay_toggle" android:textColor="#E9EBEE" android:textSize="16sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/qa_overlay_description"
        android:textColor="#8A9099" android:textSize="12sp" />
    <Button android:id="@+id/qa_close" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:text="@string/qa_done" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
